# Local Supabase values. Copy this file to .env.local and replace these placeholders.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Used only by server-side provisioning jobs. Never expose with NEXT_PUBLIC_ or import into client code.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Hosts registered in platform.tenant_domains. Use e.g. demo.localhost for local development.
NEXT_PUBLIC_APP_BASE_DOMAIN=localhost
AGENCIA3D_APP_URL=http://demo.localhost:3000
AGENCIA3D_ADMIN_HOST=admin.localhost:3000

# OpenAI Responses API. Server-only: never prefix the key with NEXT_PUBLIC_.
OPENAI_API_KEY=sk_replace_me
OPENAI_MODEL=gpt-5.4-mini
AI_RATE_LIMIT_SALT=replace_with_a_server_secret
AI_USER_REQUESTS_PER_MINUTE=10
AI_IP_REQUESTS_PER_MINUTE=30
AI_TENANT_REQUESTS_PER_DAY=200
AI_TENANT_TOKENS_PER_DAY=500000
AI_TENANT_BUDGET_USD_PER_DAY=10
OPENAI_INPUT_COST_PER_1M_USD=0.75
OPENAI_OUTPUT_COST_PER_1M_USD=4.5
